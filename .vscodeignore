**/.git/**
**/.github/**
**/.vscode/**
**/.vscode-test/**
**/.agents/**
**/.cursor/**
**/.claude/**
**/src/**
**/test/**
**/dist-test/**
**/*.map
*.vsix
.vscodeignore
.gitignore
.npmrc
webpack.config.js
eslint.config.mjs
tsconfig.json
tsconfig.test.json

# Project documentation / planning not required at runtime
AGENTS.md
PLAN.md
CHAT_ANALYSIS_PLAN.md
PROJECT_CHAT_AUTOSAVE_PLAN.md
Monetization*.md
raw/**
wiki/**

# Marketplace screenshot capture brief — dev-only; the PNG/GIF assets in this
# folder still ship in the VSIX so the listing README images resolve offline.
media/screenshots/README.md

# Local workspace/session data
.chat/**
knowledge/**

# Kanban board / task tracking — dev-only
.mwnn/**

# Pro extension workspace stub — separate product, not part of this VSIX
session-control-pro/**

# Build / development only
scripts/**
node_modules/**
debug.log
**/*.log

# @tempuskg/session-control-pro is loaded at runtime via a dynamic
# require.resolve() (src/pro/loader.ts), so webpack cannot inline it into
# dist/extension.js — it must ship as a real node_modules directory instead.
# Only the manifest + compiled entry point are needed; excluding the
# sourcemap keeps the private package from being trivially de-minified.
!node_modules/@tempuskg/session-control-pro/package.json
!node_modules/@tempuskg/session-control-pro/dist/index.js
